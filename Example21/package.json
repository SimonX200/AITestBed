    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
