{
  "name": "session-manager",
  "version": "1.0.0",
  "description": "Session Manager with HTTP endpoints",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "esbuild sessionManager.ts --bundle --platform=node --outfile=dist/bundle.js --format=cjs --minify",
    "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns=e2e",
    "e2e": "npm test && docker stop session-manager-app 2>/dev/null || true; docker rm session-manager-app 2>/dev/null || true; bash deploy.sh && jest --testPathPattern=e2e --forceExit --detectOpenHandles; docker stop session-manager-app 2>/dev/null || true; docker rm session-manager-app 2>/dev/null || true",
    "start": "node dist/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "ts"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
