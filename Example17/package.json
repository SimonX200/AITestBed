{
  "name": "session-manager",
  "version": "1.0.0",
  "description": "Session Manager with HTTP API",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "esbuild sessionManager.ts --bundle --platform=node --outfile=dist/bundle.js --minify",
    "start": "node dist/bundle.js",
    "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns=e2e",
    "e2e": "npm test && bash run-e2e.sh"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  }
}
